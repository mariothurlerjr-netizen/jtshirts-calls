# RingCentral (from developers.ringcentral.com)
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
RC_SERVER=https://platform.ringcentral.com

# OpenAI (from platform.openai.com/api-keys)
OPENAI_API_KEY=

# Data fetch: how far back to pull on bootstrap
# Use YYYY-MM-DD format, or leave blank to default to Jan 1 of current year
HISTORY_START_DATE=

# Timezone for the dashboard (for hour-of-day analysis)
# Use America/New_York, America/Chicago, America/Los_Angeles, etc.
DISPLAY_TIMEZONE=America/New_York
